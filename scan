#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Run directly from a downloaded checkout, with no Python packages to install.
set -eu
KIT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "$#" -eq 0 ]; then
    printf '%s\n' 'Usage: ./scan "/path/to/your/project" [--setup-only | --prepare-only | --plan-only] [--json] [--continue-on-lint] [--no-fix-prompt]' >&2
    exit 2
fi
PYTHON_BIN=${PYTHON:-}
if [ -n "$PYTHON_BIN" ]; then
    if ! "$PYTHON_BIN" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
        printf '%s\n' 'PYTHON must point to Python 3.11 or newer.' >&2
        exit 2
    fi
else
    for candidate in python3.14 python3.13 python3.12 python3.11 python3; do
        if command -v "$candidate" >/dev/null 2>&1 &&
            "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
            PYTHON_BIN=$candidate
            break
        fi
    done
    if [ -z "$PYTHON_BIN" ]; then
        for argument in "$@"; do
            case "$argument" in
                --plan-only|--help|-h)
                    printf '%s\n' 'This read-only command needs Python 3.11+. No runtime was downloaded. Set PYTHON to an installed interpreter.' >&2
                    exit 2
                    ;;
            esac
        done
        for candidate in python3 python3.10 python3.9 /usr/bin/python3; do
            if command -v "$candidate" >/dev/null 2>&1 &&
                "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
                PYTHON_BIN=$("$candidate" "$KIT_DIR/src/swift_sonar_kit/bootstrap_runtime.py")
                break
            fi
        done
        if [ -z "$PYTHON_BIN" ] || ! "$PYTHON_BIN" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
            printf '%s\n' 'Automatic runtime setup needs an existing Python 3.9+ host interpreter. Install Xcode Command Line Tools or set PYTHON to Python 3.11+.' >&2
            exit 2
        fi
    fi
fi
export PYTHONPATH="$KIT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON_BIN" -m swift_sonar_kit run "$@"
